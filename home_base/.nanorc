## 界面行为设置
set tabsize 4                # 制表符宽度为4空格
set tabstospaces             # 输入制表符时自动转为空格
set autoindent               # 自动缩进新行
set constantshow             # 持续显示光标位置（行/列）
set linenumbers              # 显示行号
set numbercolor cyan,black   # 行号颜色（青色文本）

## 编辑交互优化
set mouse                    # 启用鼠标支持（终端需支持）
set multibuffer              # 允许多文件缓冲区
set zap                      # 未选中文本时退格/删除不删行
set afterends                # 单词删除/移动时识别单词边界
set atblanks                 # 按行移动时在空白处停止（增强跳行）

## 界面提示增强
set titlecolor cyan,black    # 标题栏颜色
set promptcolor black,cyan   # 提示栏颜色
set statuscolor black,green  # 状态栏颜色
set errorcolor black,red     # 错误信息颜色
set selectedcolor black,cyan # 选中文本背景色
set stripecolor yellow       # 空行指示线颜色（80列标记）

## 功能开关
set nonewlines               # 不在文件末尾自动追加换行

## 语法高亮（加载系统语法文件，若无则跳过）
include "/usr/share/nano/*.nanorc" 2>/dev/null || true

## 额外功能绑定
bind ^X undo main            # Alt+U 撤销
bind ^Q exit main             # Ctrl+Q 退出（避免误触Ctrl+X习惯）
bind ^S writeout main
bind ^V paste main
